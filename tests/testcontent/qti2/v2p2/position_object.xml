    identifier="position_object" title="Position object" adaptive="false" timeDependent="false">
    <responseDeclaration identifier="RESPONSE" cardinality="multiple" baseType="point"/>
    <outcomeDeclaration identifier="SCORE" cardinality="single" baseType="float"/>
    <itemBody>
        <qh5:figure><qh5:figcaption>Place the pixel.</qh5:figcaption></qh5:figure>
        <positionObjectStage>
            <object type="image/png" data="images/pic.png" width="2" height="2"/>
            <positionObjectInteraction responseIdentifier="RESPONSE" maxChoices="2" centrePoint="1 1">
                <object type="image/png" data="images/pic.png" width="1" height="1"/>
            </positionObjectInteraction>
        </positionObjectStage>
    </itemBody>
</assessmentItem>
